# Prefer `uv run komorebi-admin init` to generate private random keys.
KOMOREBI_DATABASE_URL=postgresql+psycopg://komorebi:komorebi@127.0.0.1:5432/komorebi
# Use a separate DDL-capable account for deployment migrations.
# KOMOREBI_MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:password@localhost/komorebi
KOMOREBI_SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# KOMOREBI_ENCRYPTION_KEY=
KOMOREBI_ENVIRONMENT=development
# Only for loopback HTTP development; production must use secure cookies and TLS.
KOMOREBI_SECURE_COOKIES=false
KOMOREBI_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KOMOREBI_ALLOWED_HOSTS=["localhost","127.0.0.1"]
KOMOREBI_FILE_ROOT=.data/files
KOMOREBI_ENABLED_MODULES=["tasks","usage","conversations","learn"]
KOMOREBI_EXTERNAL_JOBS_ENABLED=false
KOMOREBI_AI_DISCLOSURE_ALLOWED=false
KOMOREBI_AI_MONTHLY_BUDGET_UNITS=100000
